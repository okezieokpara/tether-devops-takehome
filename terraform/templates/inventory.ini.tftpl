[nodes]
%{ for name, ip in hosts ~}
${name} ansible_host=${ip}
%{ endfor ~}

[nodes:vars]
ansible_user=${ansible_user}
# Relative to this file, so the inventory works from any checkout.
ansible_ssh_private_key_file={{ inventory_dir }}/../terraform/.generated/ansible_ssh_key
# Fleet-local known_hosts: rebuilt VMs reuse IPs with new host keys, so keep them
# out of ~/.ssh/known_hosts and drop the file on `make destroy`.
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile={{ inventory_dir }}/../terraform/.generated/known_hosts'
